{
  "version": 1,
  "id": "Gameplay",
  "displayName": "Gameplay",
  "priority": 100,
  "consumeInput": false,
  "enabledByDefault": true,
  "bindings": [
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "A", "scale": -1.0, "component": 0 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "Left", "scale": -1.0, "component": 0 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "D", "scale": 1.0, "component": 0 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "Right", "scale": 1.0, "component": 0 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "W", "scale": 1.0, "component": 1 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "Up", "scale": 1.0, "component": 1 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "S", "scale": -1.0, "component": 1 },
    { "action": "Gameplay.Move", "source": "Keyboard", "control": "Down", "scale": -1.0, "component": 1 },
    { "action": "Gameplay.Move", "source": "GamepadAxis", "control": "LeftX", "scale": 1.0, "component": 0, "deadZone": 0.15 },
    { "action": "Gameplay.Move", "source": "GamepadAxis", "control": "LeftY", "scale": 1.0, "component": 1, "deadZone": 0.15 },
    { "action": "Gameplay.Look", "source": "GamepadAxis", "control": "RightX", "scale": 1.0, "component": 0, "deadZone": 0.15 },
    { "action": "Gameplay.Look", "source": "GamepadAxis", "control": "RightY", "scale": 1.0, "component": 1, "deadZone": 0.15 },
    { "action": "Gameplay.Jump", "source": "Keyboard", "control": "Space", "scale": 1.0, "component": 0 },
    { "action": "Gameplay.Jump", "source": "GamepadButton", "control": "A", "scale": 1.0, "component": 0 },
    { "action": "Gameplay.Interact", "source": "Keyboard", "control": "E", "scale": 1.0, "component": 0 },
    { "action": "Gameplay.Interact", "source": "GamepadButton", "control": "X", "scale": 1.0, "component": 0 }
  ]
}
